<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Allows us to override night specific attributes in the values-night folder. -->
    <style name="NightAdjusted.Theme.Relic" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- The final theme we use -->
    <style name="Theme.Relic" parent="NightAdjusted.Theme.Relic">
        <!-- Optional: set to transparent if your app is drawing behind the status bar. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Optional: set to transparent if your app is drawing behind the navigation bar. -->
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Optional: set for a light status bar with dark content. -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- Optional: set for a light navigation bar with dark content. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Relic.Splash" parent="Theme.Relic">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#CCFFFFFF</item>
    </style>

</resources>